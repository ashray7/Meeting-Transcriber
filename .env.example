# ollama (local) | openai | demo
AI_PROVIDER=ollama

# Local Ollama settings
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen3:8b
OLLAMA_NUM_CTX=8192
WHISPER_BIN=~/.local/bin/whisper-cli
WHISPER_MODEL=small
WHISPER_MODEL_PATH=~/.local/share/meeting-to-tickets/ggml-small.bin
# Requires a whisper.cpp build with Vulkan support; Vulkan works across AMD/NVIDIA GPUs.
WHISPER_USE_GPU=true
WHISPER_THREADS=4
WHISPER_TIMEOUT_MS=2700000
FFMPEG_BIN=ffmpeg
FFMPEG_TIMEOUT_MS=900000

# Only needed when AI_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_TRANSCRIPTION_MODEL=whisper-1
OPENAI_ANALYSIS_MODEL=gpt-4o-mini

MAX_UPLOAD_MB=100
